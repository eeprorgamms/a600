{
  "name": "a500-carwash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && node scripts/generate-seo.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && node scripts/site-audit.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "predev": "node scripts/prepare-gallery.mjs",
    "prebuild": "node scripts/prepare-gallery.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "sharp": "0.35.5"
  }
}
